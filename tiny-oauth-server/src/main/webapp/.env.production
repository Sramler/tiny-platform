# 生产环境配置
# 使用方式: npm run build:prod

# 环境标识
VITE_APP_ENV=prod

# 同源 BFF：生产网关按真实领域路径转发，不增加 /api 前缀。
VITE_API_BASE_URL=

# 日志配置（覆盖 .env 中的通用配置）
VITE_ENABLE_CONSOLE_LOG=false
VITE_ENABLE_CONSOLE_DEBUG=false
VITE_LOG_LEVEL=error

# 持久化日志配置
VITE_ENABLE_PERSISTENT_LOG=false

# Web 控制面仅持有 HttpOnly Session Cookie，不在浏览器保存 OAuth token。
VITE_AUTH_SESSION_ONLY=true
VITE_OIDC_STORAGE=session
